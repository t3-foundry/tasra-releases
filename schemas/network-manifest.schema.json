{
  "type": "object",
  "required": [
    "schemaVersion",
    "network",
    "chainId",
    "deploymentId",
    "revision",
    "status",
    "protocolVersion",
    "verifiedAt",
    "contracts",
    "services"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "network": {
      "enum": [
        "local",
        "testnet",
        "mainnet"
      ]
    },
    "chainId": {
      "enum": [
        43112,
        43113,
        43114
      ]
    },
    "deploymentId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "retired"
      ]
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "verifiedAt": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "blockNumber",
            "blockHash",
            "timestamp"
          ],
          "properties": {
            "blockNumber": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "blockHash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "contracts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "name",
          "address",
          "abi",
          "runtimeCodeHash",
          "deployment",
          "create2",
          "proxy"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "abi": {
            "type": "string",
            "pattern": "^contracts/abi/[A-Za-z0-9/_.-]+\\.json$"
          },
          "runtimeCodeHash": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              }
            ]
          },
          "deployment": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "transactionHash",
                  "blockNumber"
                ],
                "properties": {
                  "transactionHash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  },
                  "blockNumber": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  }
                }
              }
            ]
          },
          "create2": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "factory",
                  "salt",
                  "initCodeHash"
                ],
                "properties": {
                  "factory": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "salt": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  },
                  "initCodeHash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  }
                }
              }
            ]
          },
          "proxy": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "implementation",
                  "runtimeCodeHash",
                  "upgradeAuthority"
                ],
                "properties": {
                  "implementation": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "runtimeCodeHash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  },
                  "upgradeAuthority": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{40}$"
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "services": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "url"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structural schema; SDK additionally checks chain mapping, CREATE2, active evidence, unique names and public URLs."
}
